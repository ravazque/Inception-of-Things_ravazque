# -*- mode: ruby -*-
# vi: set ft=ruby :

# Part 2 - One K3s server, ravazqueS (192.168.56.110), with three apps behind one Ingress:
#   app1.com -> app1 | app2.com -> app2 | anything else -> app3

LOGIN     = "ravazque"
SERVER_IP = "192.168.56.110"

Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.define "#{LOGIN}S" do |server|
    server.vm.hostname = "#{LOGIN}S"
    server.vm.network "private_network", ip: SERVER_IP

    server.vm.provider "libvirt" do |lv|
      lv.cpus   = 1
      lv.memory = 1024
    end
    server.vm.provider "virtualbox" do |vb|
      vb.cpus   = 1
      vb.memory = 1024
      vb.name   = "#{LOGIN}S"
    end

    # Upload the manifests, then install K3s and apply them.
    server.vm.provision "file", source: "confs", destination: "/home/vagrant/confs"
    server.vm.provision "shell", path: "scripts/setup.sh", args: [SERVER_IP]
  end
end
